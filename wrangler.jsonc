{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "zoneboard",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-24",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "vars": {
    "API_BASE_URL": "https://api.cloudflare.com/client/v4"
  }
}
